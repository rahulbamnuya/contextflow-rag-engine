# ==============================================================================
# Environment Configuration for Adaptive RAG Project
# ==============================================================================

# LLM Client settings (Support standard OpenAI, OpenRouter, Groq, local LM Studio, etc.)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=
OPENAI_MODEL_NAME=gpt-4o

# Tavily Search Engine settings (For live web search fallback)
TAVILY_API_KEY=your_tavily_api_key_here

# Qdrant Vector Database configurations
# For local Docker setup, set QDRANT_URL=http://qdrant:6333
# For Qdrant Cloud, set QDRANT_URL=https://<your-cluster-id>.qdrant.io:6333 and provide the API key
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_CODE_COLLECTION=codebase
QDRANT_DOCS_COLLECTION=guidelines

# MongoDB settings
# For local Docker setup, set MONGO_URI=mongodb://mongodb:27017
# For cloud MongoDB Atlas, use mongodb+srv://<user>:<password>@cluster.mongodb.net/
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=adaptive_rag

# Langfuse Observability Tracing settings
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
